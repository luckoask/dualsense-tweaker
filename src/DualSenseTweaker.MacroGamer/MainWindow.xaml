<Window x:Class="DualSenseTweaker.MacroGamer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:DualSenseTweaker.MacroGamer.Localization"
 Title="Macro Gamer · LCKS" Width="1280" Height="850" MinWidth="1040" MinHeight="680"
 Background="{DynamicResource WindowBrush}" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
 Icon="Assets/app.ico" WindowStartupLocation="CenterScreen">
 <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="F10" Modifiers="Control+Shift" Command="{Binding StopAllCommand}"/></Window.InputBindings>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0" Padding="20,28,20,20">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="LCKS" FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="{StaticResource BrandGradient}"/><TextBlock Text="Macro Gamer" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,8"/><TextBlock Text="{l:Text 'Samostatný makro runtime'}" Style="{StaticResource Muted}"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding EmergencyStatus}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="4,14,0,6"/><TextBlock Text="{l:Text 'Núdzové zastavenie'}" Style="{StaticResource Muted}"/><Button Content="{l:Text 'STOP VŠETKO'}" Style="{StaticResource Danger}" Command="{Binding StopAllCommand}" AutomationProperties.Name="Emergency stop all macros"/></StackPanel>
    <ListBox ItemsSource="{Binding Navigation}" SelectedIndex="{Binding Section}" Background="Transparent" BorderThickness="0" Padding="0" DisplayMemberPath="Title" AutomationProperties.Name="Navigation"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,22,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,12,20">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{l:Text 'Uložiť profil'}" Command="{Binding SaveCommand}" Margin="0,0,10,0"/><Button Content="{l:Text 'Zapnúť engine'}" Command="{Binding EnableCommand}"/><Border Background="{DynamicResource ItemBrush}" CornerRadius="10" Padding="12,9" Margin="10,0,0,0"><TextBlock Text="{Binding EngineState}" FontFamily="{StaticResource MonoFont}"/></Border></StackPanel>
    <StackPanel><TextBlock Text="{l:Text 'AKTÍVNY PROFIL'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding ActiveProfileName}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
   </DockPanel>
   <TabControl Grid.Row="1" SelectedIndex="{Binding Section}" Style="{StaticResource Pages}">
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{l:Text 'Prehľad'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Tvoj ovládač. Tvoje sekvencie. Všetko pod kontrolou.'}" Style="{StaticResource Muted}"/>
     <UniformGrid Columns="2">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'OVLÁDAČ'}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ConnectionText}" FontSize="22"/><TextBlock Text="{Binding BatteryText}" FontSize="30" Margin="0,12,0,0"/><TextBlock Text="{Binding SourceText}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'ENGINE'}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding EngineState}" FontSize="24"/><TextBlock Text="{Binding ActiveMacros}" Margin="0,12,0,0"/><TextBlock Text="{Binding ActiveScripts}" Margin="0,8,0,0"/><TextBlock Text="{l:Text 'Pri každom spustení je engine vypnutý.'}" Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'VÝSTUP'}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding BackendStatus}" FontSize="17"/><TextBlock Text="{l:Text 'Aktívne syntetické vstupy'}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding HeldOutputs}" FontFamily="{StaticResource MonoFont}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'POSLEDNÝ VSTUP'}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding InputText}" FontFamily="{StaticResource MonoFont}" FontSize="12"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'Začni bezpečne'}" FontSize="20"/><TextBlock Text="{l:Text 'Otvor Tweaker, pripoj ovládač a vyber diagnostický výstup. Povoľ makro R1 → E, ulož profil a zapni engine. V diagnostike uvidíš skutočné udalosti Down/Up. Klávesnicu a myš zvoľ až pre aplikáciu, ktorá takéto vstupy podporuje.'}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{l:Text 'Ovládače'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Jedno HID pripojenie spravuje DualSense Tweaker. Macro Gamer prijíma jeho normalizované vstupy cez lokálny kanál.'}" Style="{StaticResource Muted}"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding SourceText}" FontSize="18"/><TextBlock Text="{Binding SourceError}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,16"/><Button Content="{l:Text 'Otvoriť DualSense Tweaker'}" Command="{Binding LaunchTweakerCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'Pripojené ovládače'}" FontSize="20"/><ListBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding ControllerCandidate}" MinHeight="130" Margin="0,14,0,14"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Model}" FontSize="17"/><TextBlock Text="{Binding Transport}"/><TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="11"/><TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="{l:Text 'Priradiť vybraný ovládač'}" Command="{Binding ApplyControllerCommand}" Margin="0,0,10,0"/><Button Content="{l:Text 'Automatický výber'}" Command="{Binding AutomaticControllerCommand}"/></WrapPanel><TextBlock Text="{Binding ControllerAssociation}" Margin="0,16,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><TextBlock Text="{Binding InputText}" FontFamily="{StaticResource MonoFont}"/></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{l:Text 'Makrá'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Uložené sekvencie majú vlastné spúšťače, opakovanie a časové limity. Zmeny makier pri uložení bezpečne vypnú engine.'}" Style="{StaticResource Muted}"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" Margin="0,0,14,14"><ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox IsChecked="{Binding Enabled}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock Text="{Binding Buttons}" FontFamily="{StaticResource MonoFont}"/><TextBlock Text="{Binding Mode}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <WrapPanel Grid.Row="2"><Button Content="{l:Text 'Nové makro'}" Command="{Binding NewMacroCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Upraviť'}" Command="{Binding EditMacroCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Spustiť makro'}" Command="{Binding RunMacroCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Importovať'}" Command="{Binding ImportMacroCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Exportovať'}" Command="{Binding ExportMacroCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Odstrániť'}" Command="{Binding DeleteMacroCommand}" Margin="0,0,8,8"/></WrapPanel>
    </Grid></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{l:Text 'Editor makier'}" Style="{StaticResource PageTitle}"/><ComboBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" DisplayMemberPath="Name" Margin="0,8,14,14"/>
     <Border Style="{StaticResource Card}"><StackPanel DataContext="{Binding SelectedMacro}">
      <TextBlock Text="{l:Text 'Názov'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/><CheckBox Content="{l:Text 'Povolené v profile'}" IsChecked="{Binding Enabled}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,14,0"><TextBlock Text="{l:Text 'Spúšťač'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.TriggerKinds, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding Trigger}" SelectedValuePath="Value" DisplayMemberPath="Label"/><TextBlock Text="{l:Text 'Tlačidlá (napr. L1+R1)'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Buttons, UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/><TextBlock Text="{l:Text 'Vyžadované tlačidlá'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RequiredButtons, UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/></StackPanel>
       <StackPanel Margin="0,0,14,0"><TextBlock Text="{l:Text 'Režim'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.RunModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding Mode}" SelectedValuePath="Value" DisplayMemberPath="Label"/><TextBlock Text="{l:Text 'Počet opakovaní'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/><CheckBox Content="{l:Text 'Opakovať počas aktivity'}" IsChecked="{Binding RepeatWhileActive}"/><TextBlock Text="{l:Text 'Maximálny čas (ms)'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaxRuntimeMs, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/></StackPanel>
       <StackPanel><TextBlock Text="{l:Text 'Analógová spúšť'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.AnalogTriggers, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding AnalogTrigger}"/><TextBlock Text="{l:Text 'Prah (1–255)'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/><TextBlock Text="{l:Text 'Držanie pred spustením (ms)'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding HeldMs, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/></StackPanel>
      </Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0"><TextBlock Text="{l:Text 'Poradie akcií'}" FontSize="20"/><ListBox ItemsSource="{Binding SelectedMacro.Actions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="Label" Height="220" Margin="0,14,0,12"/><WrapPanel><Button Content="{l:Text 'Pridať'}" Command="{Binding AddActionCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Odstrániť'}" Command="{Binding RemoveActionCommand}" Margin="0,0,8,8"/><Button Content="↑" Command="{Binding UpActionCommand}" AutomationProperties.Name="Move action up" Margin="0,0,8,8"/><Button Content="↓" Command="{Binding DownActionCommand}" AutomationProperties.Name="Move action down"/></WrapPanel></StackPanel>
      <StackPanel Grid.Column="1" DataContext="{Binding SelectedAction}"><TextBlock Text="{l:Text 'Akcia'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.ActionKinds, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding Kind}" SelectedValuePath="Value" DisplayMemberPath="Label"/><TextBlock Text="{l:Text 'Kláves alebo tlačidlo myši'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsesControl}" MaxLength="16"/><TextBlock Text="{l:Text 'Čas (ms)'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsesDuration}" MaxLength="12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="X" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsesMouseValues}" MaxLength="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Y / Wheel" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsesMouseValues}" MaxLength="12"/></StackPanel></Grid></StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'Záznam a prehrávanie'}" FontSize="20"/><TextBlock Text="{Binding RecordingState}" Margin="0,10,0,10"/><WrapPanel><Button Content="{l:Text 'Nahrať vstupy'}" Command="{Binding RecordCommand}" Margin="0,0,10,10"/><Button Content="{l:Text 'Zastaviť záznam'}" Command="{Binding StopRecordCommand}" Margin="0,0,10,10"/></WrapPanel>
      <ListBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" Height="90" Margin="0,0,0,12"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding ControllerId}"/><Run Text=" · "/><Run Text="{Binding Points.Length}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding RecordingSummary}" FontFamily="{StaticResource MonoFont}"/>
      <TextBlock Text="{l:Text 'Prehrávanie používa mapované tlačidlá. Analógové a dotykové dáta zostávajú v zázname; virtuálny gamepad nie je dostupný.'}" Style="{StaticResource Muted}" Margin="0,14,0,12"/>
      <DataGrid ItemsSource="{Binding RecordingMappings}" SelectedItem="{Binding SelectedMapping}" AutoGenerateColumns="False" CanUserAddRows="False" Height="125" Background="{DynamicResource ItemBrush}" Foreground="{DynamicResource TextBrush}"><DataGrid.Columns><DataGridTextColumn Header="{l:Text 'Tlačidlo'}" Binding="{Binding Button, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="{l:Text 'Kláves'}" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
      <WrapPanel Margin="0,12,0,0"><Button Content="{l:Text 'Pridať mapovanie'}" Command="{Binding AddMappingCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Odstrániť mapovanie'}" Command="{Binding RemoveMappingCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Vytvoriť makro zo záznamu'}" Command="{Binding RecordingToMacroCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Odstrániť záznam'}" Command="{Binding DeleteRecordingCommand}"/></WrapPanel>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{l:Text 'Skripty'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Lua beží v izolovanom procese. Úpravy a uloženie nemenia snapshot bežiaceho skriptu. Na novú verziu použi Zastaviť a Spustiť.'}" Style="{StaticResource Muted}"/><DockPanel Margin="0,0,14,12"><Button Content="{l:Text 'Nový skript'}" Command="{Binding NewScriptCommand}" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="Name"/></DockPanel><DockPanel DataContext="{Binding SelectedScript}" Margin="0,0,14,12"><CheckBox Content="{l:Text 'Povolené v profile'}" IsChecked="{Binding Enabled}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/></DockPanel></StackPanel>
     <TextBox Grid.Row="1" Text="{Binding SelectedScript.Source, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScriptBox}" MaxLength="64000" Margin="0,0,14,14" AutomationProperties.Name="Lua script editor"/>
     <StackPanel Grid.Row="2"><WrapPanel><Button Content="{l:Text 'Overiť'}" Command="{Binding ValidateScriptCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Spustiť skript'}" Command="{Binding RunScriptCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Zastaviť skripty'}" Command="{Binding StopScriptsCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Načítať'}" Command="{Binding LoadScriptCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Exportovať'}" Command="{Binding ExportScriptCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Odstrániť'}" Command="{Binding DeleteScriptCommand}" Margin="0,0,8,8"/></WrapPanel><DockPanel Margin="0,4,14,12"><Button Content="{l:Text 'Načítať príklad'}" Command="{Binding LoadSampleCommand}" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}"/></DockPanel><TextBlock Text="{Binding ScriptError}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource OrangeBrush}" MaxHeight="90"/></StackPanel>
    </Grid></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{l:Text 'Profily'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Profily Macro Gamer sú oddelené od nastavení Tweaker. Prepnutie profilu vždy vypne engine.'}" Style="{StaticResource Muted}"/>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="{l:Text 'Aktivovať'}" Command="{Binding ActivateProfileCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ProfileCandidate}" DisplayMemberPath="Name"/></DockPanel><TextBlock Text="{l:Text 'Názov aktívneho profilu'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/><TextBlock Text="{l:Text 'Herný program (voliteľné)'}" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="…" Command="{Binding PickGameCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" AutomationProperties.Name="Choose game executable"/><TextBox Text="{Binding GameExecutable, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024"/></DockPanel><TextBlock Text="{l:Text 'Výstupný backend'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Backends}" SelectedValue="{Binding Backend}" SelectedValuePath="Value" DisplayMemberPath="Label"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource DropItem}"><Setter Property="IsEnabled" Value="{Binding Available}"/></Style></ComboBox.ItemContainerStyle></ComboBox><TextBlock Text="{Binding BackendStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock Text="{l:Text 'Číselné premenné profilu (JSON)'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VariablesJson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScriptBox}" Height="100" MaxLength="8192"/></StackPanel></Border>
     <WrapPanel><Button Content="{l:Text 'Nový profil'}" Command="{Binding NewProfileCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Duplikovať'}" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Odstrániť'}" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Importovať'}" Command="{Binding ImportProfileCommand}" Margin="0,0,8,8"/><Button Content="{l:Text 'Exportovať'}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,8"/></WrapPanel>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{l:Text 'Diagnostika'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Časovanie, chyby, skutočné výstupné udalosti a držané vstupy. Časy v zázname sú UTC.'}" Style="{StaticResource Muted}"/><WrapPanel Margin="0,0,0,12"><Button Content="{l:Text 'Exportovať záznam'}" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,10,0"/><Button Content="{l:Text 'Vyčistiť záznam'}" Command="{Binding ClearDiagnosticsCommand}"/></WrapPanel></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Diagnostics}" Margin="0,0,14,12"><ListBox.ItemTemplate><DataTemplate><TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"><Run Text="{Binding At, StringFormat={}{0:HH:mm:ss.fff}}"/><Run Text=" · "/><Run Text="{Binding Level}"/><Run Text=" · "/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="2" Text="{Binding HeldOutputs}" Margin="0,0,0,10" FontFamily="{StaticResource MonoFont}"/>
     <ListBox Grid.Row="3" ItemsSource="{Binding OutputEvents}" Margin="0,0,14,0"><ListBox.ItemTemplate><DataTemplate><TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"><Run Text="{Binding Timestamp}"/><Run Text=" · "/><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Control}"/><Run Text=" · "/><Run Text="{Binding X}"/><Run Text=", "/><Run Text="{Binding Y}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{l:Text 'Nastavenia'}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Text 'Macro Gamer sa nespúšťa automaticky a nepovoľuje makrá pri štarte.'}" Style="{StaticResource Muted}"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'Jazyk'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/><TextBlock Text="{l:Text 'Vzhľad'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/><CheckBox Content="{l:Text 'Vyberať profil podľa aktívnej hry'}" IsChecked="{Binding AutoGameProfiles}"/><TextBlock Text="{l:Text 'Automatické prepnutie nikdy nezapne engine.'}" Style="{StaticResource Muted}"/><TextBlock Text="{l:Text 'Núdzová klávesová skratka'}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding EmergencyStatus}" FontFamily="{StaticResource MonoFont}"/><Button Content="{l:Text 'Uložiť nastavenia'}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{l:Text 'Samostatné dáta aplikácie'}" FontSize="20"/><TextBlock Text="{Binding DataDirectory}" FontFamily="{StaticResource MonoFont}" Margin="0,12,0,12"/><Button Content="{l:Text 'Otvoriť priečinok'}" Command="{Binding OpenDataCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
     <TextBlock Text="{l:Text 'Klávesnica a myš používajú Windows SendInput. Podpora v konkrétnej hre závisí od jej nastavení a pravidiel. Fyzický ovládač ostáva viditeľný; Steam Input môže pridať vlastné mapovanie. PS5 a Remote Play nie sú podporované výstupy.'}" Style="{StaticResource Muted}"/>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0" Padding="12,10" Margin="0,16,12,0" CornerRadius="10"><TextBlock Text="{Binding Status}" MaxHeight="44"/></Border>
  </Grid>
 </Grid>
</Window>
