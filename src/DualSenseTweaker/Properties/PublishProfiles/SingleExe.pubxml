<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained DualSenseTweaker.exe (no .NET install needed on the target PC). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression would shrink the .exe to ~73 MB, but the compressed assemblies are unpacked into
         memory at start: ~320 MB instead of ~200 MB working set for an app that lives in the tray. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Precompiled code: the window opens noticeably faster (no JIT at startup) for ~20 MB more. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Also skip the .pdb of the referenced Core project. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
