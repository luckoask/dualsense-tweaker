<UserControl x:Class="DualSenseTweaker.Controls.SwitchRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <DockPanel Margin="0,6">
        <CheckBox DockPanel.Dock="Right" Margin="14,0,0,0" Style="{StaticResource Switch}"
                  IsChecked="{Binding IsChecked, ElementName=Root}" />
        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Title, ElementName=Root}" />
            <TextBlock x:Name="HintText" Style="{StaticResource SettingHint}" Text="{Binding Hint, ElementName=Root}" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</UserControl>
